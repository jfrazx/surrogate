{
  "name": "surrogate",
  "version": "0.0.0-development",
  "description": "Object method hooks made easy",
  "source": "src/index.ts",
  "main": "dist/main.js",
  "module": "dist/module.mjs",
  "types": "dist/types.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types.d.mts",
        "default": "./dist/module.mjs"
      },
      "require": {
        "types": "./dist/types.d.ts",
        "default": "./dist/main.js"
      }
    }
  },
  "keywords": [
    "hooks",
    "hook",
    "proxy",
    "hooking",
    "pre",
    "post",
    "flow",
    "control",
    "async",
    "sync",
    "api"
  ],
  "scripts": {
    "cspell": "cspell lint --no-progress --fail-fast \"**\"",
    "test": "mocha",
    "test:watch": "mocha --watch",
    "compile": "tsc --noEmit --noErrorTruncation",
    "tsc": "tsc",
    "predocs": "rimraf docs",
    "docs": "typedoc src/index.ts",
    "del:merged": "tsx scripts/merged.ts",
    "leak:test": "tsx --tsconfig test/tsconfig.json scripts/leak.ts",
    "prebuild": "rimraf dist",
    "build": "parcel build",
    "postbuild": "node -e \"require('fs').copyFileSync('dist/types.d.ts', 'dist/types.d.mts')\"",
    "precoverage:report": "npm run coverage:test",
    "coverage:report": "c8 report --reporter=text-lcov > coverage.lcov",
    "precoverage:test": "rimraf coverage",
    "coverage:test": "c8 mocha",
    "lint": "eslint src --report-unused-disable-directives",
    "prepack": "npm run build",
    "prettier": "prettier --write \"src/**/*.{ts,js,tsx,jsx,json,md}\"",
    "prettier:check": "prettier --check \"src/**/*.{ts,js,tsx,jsx,json,md}\"",
    "mocha": "mocha"
  },
  "author": "jfrazx",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@jfrazx/asarray": "^1.0.1",
    "@status/defaults": "^1.6.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@parcel/bundler-library": "^2.15.4",
    "@parcel/packager-ts": "^2.15.4",
    "@parcel/transformer-typescript-types": "^2.15.4",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.0.0",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@types/chai": "^5.0.0",
    "@types/fast-redact": "^3.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/sinon": "^22.0.0",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "commitizen": "^4.3.1",
    "cspell": "^10.4.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "fast-redact": "^3.5.0",
    "mocha": "^12.0.3",
    "monocart-coverage-reports": "^2.13.2",
    "parcel": "^2.15.4",
    "prettier": "^3.0.0",
    "publint": "^0.3.25",
    "rimraf": "^6.0.1",
    "semantic-release": "^25.0.0",
    "sinon": "^22.0.0",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "mocha": {
    "recursive": true,
    "spec": "test/*.spec.ts",
    "reporter": "spec",
    "require": [
      "./test/register.cjs"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jfrazx/surrogate.git"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "angular",
          "releaseRules": [
            {
              "breaking": true,
              "release": "major"
            },
            {
              "type": "docs",
              "scope": "README",
              "release": "patch"
            },
            {
              "type": "refactor",
              "release": "patch"
            },
            {
              "type": "style",
              "release": "patch"
            }
          ],
          "parserOpts": {
            "noteKeywords": [
              "BREAKING CHANGE",
              "BREAKING CHANGES"
            ]
          }
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/github",
      "@semantic-release/npm"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
